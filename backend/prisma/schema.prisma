generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlanType {
  WEEKLY
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum RecipeSource {
  SPOONACULAR
  AI_GENERATED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pantryItems     PantryItem[]
  nutritionalGoal NutritionalGoal?
  dietaryProfile  DietaryProfile?
  mealPlans       MealPlan[]
}

model DietaryProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  diets               String[] @default([])
  intolerances        String[] @default([])
  allergies           String[] @default([])
  excludedIngredients String[] @default([])
  preferredCuisines   String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NutritionalGoal {
  id           String   @id @default(uuid())
  userId       String   @unique
  dailyCalories Int
  dailyProtein  Int
  dailyCarbs    Int
  dailyFat      Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Ingredient {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pantryItems PantryItem[]
}

model PantryItem {
  id           String   @id @default(uuid())
  userId       String
  ingredientId String
  quantity     Float?
  unit         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([userId, ingredientId])
}

model Recipe {
  id                     String       @id @default(uuid())
  sourceType             RecipeSource
  spoonacularId          Int?         @unique
  title                  String
  instructions           Json?
  imageUrl               String?
  sourceUrl              String?
  readyInMinutes         Int?
  servings               Int?
  caloriesPerServing     Float?
  proteinGramsPerServing Float?
  carbsGramsPerServing   Float?
  fatGramsPerServing     Float?
  nutritionalInfo        Json?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  mealPlanEntries MealPlanEntry[]

  @@index([sourceType])
}

model MealPlan {
  id        String   @id @default(uuid())
  userId    String
  planType  PlanType @default(WEEKLY)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries MealPlanEntry[]

  @@index([userId, startDate, endDate])
}

model MealPlanEntry {
  id         String   @id @default(uuid())
  mealPlanId String
  day        DateTime
  mealType   MealType
  slotIndex  Int      @default(0)
  recipeId   String
  isLocked   Boolean  @default(false)
  createdAt  DateTime @default(now())

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipe   Recipe   @relation(fields: [recipeId], references: [id])

  @@unique([mealPlanId, day, mealType, slotIndex])
  @@index([mealPlanId, day])
  @@index([day])
}
