generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlanType {
  SINGLE_DAY
  WEEKLY
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum RecipeSource {
  SPOONACULAR
  AI_GENERATED
  USER_CREATED
}

enum PantryReservationStatus {
  RESERVED
  CONSUMED
  RELEASED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pantryItems     PantryItem[]
  nutritionalGoal NutritionalGoal?
  dietaryProfile  DietaryProfile?
  mealPlans       MealPlan[]
  authoredRecipes Recipe[]         @relation("RecipeAuthor")
}

model DietaryProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  diets               String[] @default([])
  intolerances        String[] @default([])
  allergies           String[] @default([])
  excludedIngredients String[] @default([])
  preferredCuisines   String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NutritionalGoal {
  id                  String   @id @default(uuid())
  userId              String   @unique
  dailyCalories       Int
  dailyProtein        Int
  dailyCarbs          Int
  dailyFat            Int
  calorieTolerancePct Int      @default(10)
  macroTolerancePct   Int      @default(15)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Ingredient {
  id            String   @id @default(uuid())
  spoonacularId Int?     @unique
  name          String   @unique
  aisle         String?
  imageUrl      String?
  defaultUnit   String?
  calories      Float?
  proteins      Float?
  carbohydrates Float?
  fats          Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pantryItems       PantryItem[]
  recipeIngredients RecipeIngredient[]
  reservations      PantryReservation[]
}

model PantryItem {
  id                 String    @id @default(uuid())
  userId             String
  ingredientId       String
  quantity           Float?
  unit               String?
  normalizedQuantity Float?
  normalizedUnit     String?
  purchasedAt        DateTime  @default(now())
  expirationDate     DateTime?
  note               String?
  isStaple           Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient   Ingredient          @relation(fields: [ingredientId], references: [id])
  reservations PantryReservation[]

  @@index([userId, expirationDate])
  @@index([userId, ingredientId])
}

model Recipe {
  id                     String       @id @default(uuid())
  sourceType             RecipeSource
  spoonacularId          Int?         @unique
  authorId               String?
  title                  String
  summary                String?
  instructions           Json?
  imageUrl               String?
  sourceUrl              String?
  readyInMinutes         Int?
  servings               Int?
  caloriesPerServing     Float?
  proteinGramsPerServing Float?
  carbsGramsPerServing   Float?
  fatGramsPerServing     Float?
  fiberGramsPerServing   Float?
  sugarGramsPerServing   Float?
  sodiumMgPerServing     Float?
  nutritionalInfo        Json?
  tags                   String[]     @default([])
  diets                  String[]     @default([])
  cuisines               String[]     @default([])
  dishTypes              String[]     @default([])
  isPublic               Boolean      @default(false)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  author          User?              @relation("RecipeAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  mealPlanEntries MealPlanEntry[]
  ingredients     RecipeIngredient[]

  @@index([sourceType])
  @@index([authorId])
}

model RecipeIngredient {
  id                 String   @id @default(uuid())
  recipeId           String
  ingredientId       String?
  displayName        String
  quantity           Float?
  unit               String?
  normalizedQuantity Float?
  normalizedUnit     String?
  originalText       String?
  isOptional         Boolean  @default(false)
  sortOrder          Int?
  createdAt          DateTime @default(now())

  recipe       Recipe              @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient?         @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  reservations PantryReservation[]

  @@index([recipeId])
  @@index([ingredientId])
}

model MealPlan {
  id          String   @id @default(uuid())
  userId      String
  planType    PlanType @default(WEEKLY)
  startDate   DateTime
  endDate     DateTime
  notes       String?
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries MealPlanEntry[]

  @@index([userId, startDate, endDate])
}

model MealPlanEntry {
  id           String   @id @default(uuid())
  mealPlanId   String
  day          DateTime
  mealType     MealType
  slotIndex    Int      @default(0)
  recipeId     String
  servings     Int?
  isLocked     Boolean  @default(false)
  sourceReason String?
  createdAt    DateTime @default(now())

  mealPlan           MealPlan            @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipe             Recipe              @relation(fields: [recipeId], references: [id])
  pantryReservations PantryReservation[]

  @@unique([mealPlanId, day, mealType, slotIndex])
  @@index([mealPlanId, day])
  @@index([day])
}

model PantryReservation {
  id                 String                  @id @default(uuid())
  mealPlanEntryId    String
  pantryItemId       String
  recipeIngredientId String?
  ingredientId       String
  status             PantryReservationStatus @default(RESERVED)
  reservedQuantity   Float
  reservedUnit       String
  normalizedQuantity Float?
  normalizedUnit     String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  mealPlanEntry    MealPlanEntry     @relation(fields: [mealPlanEntryId], references: [id], onDelete: Cascade)
  pantryItem       PantryItem        @relation(fields: [pantryItemId], references: [id], onDelete: Cascade)
  recipeIngredient RecipeIngredient? @relation(fields: [recipeIngredientId], references: [id], onDelete: SetNull)
  ingredient       Ingredient        @relation(fields: [ingredientId], references: [id])

  @@index([mealPlanEntryId])
  @@index([pantryItemId])
  @@index([ingredientId])
  @@index([status])
}
